{
  "name": "@pocket-ledger/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:e2e": "cross-env DATABASE_URL=file:./playwright.db tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "pnpm run test:compile && node --test dist-test/test/*.test.js",
    "test:coverage": "pnpm run test:compile && c8 --all --extension .js --include dist-test/src/** --exclude dist-test/src/generated/** --reporter=text --reporter=lcov --reporter=json-summary node --test dist-test/test/*.test.js && node scripts/generate-c8-report.mjs",
    "test:mutation": "stryker run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:e2e": "cross-env DATABASE_URL=file:./playwright.db tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "drizzle-orm": "1.0.0-beta.16-c2458b2",
    "express": "^5.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^26.6.5",
    "@types/supertest": "^6.0.3",
    "c8": "^12.0.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "1.0.0-beta.16-c2458b2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
