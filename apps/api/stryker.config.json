{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "src/domain/**/*.ts",
    "src/application/transaction-service.ts",
    "src/shared/date.ts",
    "src/presentation/controllers/schema-api.ts"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "node ../../node_modules/typescript/bin/tsc -p tsconfig.test.json && node --test dist-test/tests/application/transaction-service.test.js dist-test/tests/domain/**/*.unit.test.js dist-test/tests/presentation/controllers/**/*.unit.test.js dist-test/tests/shared/date.test.js dist-test/tests/shared/sqlite-error.test.js"
  },
  "coverageAnalysis": "off",
  "concurrency": 20,
  "timeoutMS": 30000,
  "incremental": true,
  "reporters": ["clear-text", "html", "json"],
  "htmlReporter": {
    "fileName": "MUTATION_TEST_REPORT.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation.json"
  }
}
